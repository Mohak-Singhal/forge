+class TestConfig:
+    @pytest.fixture
+    def app(self):
+        app = Flask(__name__)
+        app.config.update(
+            SOME_VALUE=123,
+            SECRET_KEY="hunter2",
+            MAIL_PASSWORD="letmein",
+            API_TOKEN="abc123",
+            SESSION_KEY="nope",
+            stripe_secret_key="lower",
+            NESTED={"DB_PASSWORD": "nested", "PLAIN": 1},
+            NAME="example",
+        )
+        return app
+
+    @pytest.fixture
+    def invoke(self, app, runner):
+        cli = FlaskGroup(create_app=lambda: app)
+        return partial(runner.invoke, cli)
+
+    def test_config(self, invoke):
+        result = invoke(["config"])
+        assert result.exit_code == 0
+        data = json.loads(result.output)
+        assert data["NAME"] == "example"
+        assert data["SOME_VALUE"] == 123
+
+    def test_config_masks_sensitive_values(self, invoke):
+        data = json.loads(invoke(["config"]).output)
+        assert data["SECRET_KEY"] == "***"
+        assert data["MAIL_PASSWORD"] == "***"
+        assert data["API_TOKEN"] == "***"
+        assert data["SESSION_KEY"] == "***"
+        assert data["stripe_secret_key"] == "***"
+        assert data["NESTED"]["DB_PASSWORD"] == "***"
+        assert data["NESTED"]["PLAIN"] == 1
+        assert "hunter2" not in json.dumps(data)
+
+    def test_config_in_help(self, runner):
+        app = Flask(__name__)
+        cli = FlaskGroup(create_app=lambda: app)
+        result = runner.invoke(cli, ["--help"])
+        assert result.exit_code == 0
+        assert "config" in result.output
+
