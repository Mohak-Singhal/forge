+_masked_key_re = re.compile(r"SECRET|PASSWORD|TOKEN|KEY", re.IGNORECASE)
+
+
+def _mask_config_value(value: t.Any) -> t.Any:
+    """Recursively replace values of sensitive-looking keys in nested
+    mappings, sequences, and sets with ``"***"``.
+    """
+    if isinstance(value, cabc.Mapping):
+        return {
+            key: ("***" if _masked_key_re.search(str(key)) else _mask_config_value(val))
+            for key, val in value.items()
+        }
+
+    if isinstance(value, (list, tuple, set, frozenset)):
+        return [_mask_config_value(item) for item in value]
+
+    return value
+
+
+@click.command("config", short_help="Show the config of the app as JSON.")
+@with_appcontext
+def config_command() -> None:
+    """Show the configuration of the loaded application as JSON.
+
+    Values of keys that may hold sensitive information are replaced with a
+    masked value. A key is considered sensitive if it contains SECRET,
+    PASSWORD, TOKEN, or KEY, ignoring case.
+    """
+    config = _mask_config_value(dict(current_app.config))
+    config = dict(sorted(config.items(), key=lambda item: str(item[0])))
+    click.echo(json.dumps(config, indent=2, default=str))
+
